# Cafe24 Developer Center에서 앱 저장 후 발급된 값을 입력하세요.
CAFE24_CLIENT_ID=replace_me
CAFE24_CLIENT_SECRET=replace_me

# 비밀값이 아닙니다. 기본값도 cokorzone001 / 3 입니다.
CAFE24_MALL_ID=cokorzone001
CAFE24_SHOP_NO=3

# 배포 후 확정된 callback URL을 입력하세요.
CAFE24_REDIRECT_URI=https://your-project.vercel.app/api/cafe24/callback

# 각각 독립적인 32바이트 이상의 무작위 문자열을 사용하세요.
OAUTH_STATE_SECRET=replace_with_a_long_random_value
TOKEN_ENCRYPTION_KEY=replace_with_a_different_long_random_value

# Vercel Marketplace의 Upstash Redis 연결 시 자동으로 주입됩니다.
UPSTASH_REDIS_REST_URL=https://replace_me.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_me

# Vercel Cron 요청 인증용 무작위 비밀값입니다.
CRON_SECRET=replace_with_a_third_long_random_value

# 필요할 때만 변경하세요. 공백으로 구분합니다.
CAFE24_SCOPES=mall.read_product mall.write_product mall.read_store mall.read_category
# 하루팜/ADMINPLUS Open API (product.read 전용)
ADMINPLUS_CLIENT_ID=
ADMINPLUS_CLIENT_SECRET=

# true일 때만 Cafe24 가격·옵션 추가금·재고/품절 상태를 실제 반영
SYNC_WRITE_ENABLED=false
